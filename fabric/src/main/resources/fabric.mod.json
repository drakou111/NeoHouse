{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "NeoHouse",
  "description": "A client-side mod that lets you write, compile and run scripts for Hypixel Housing directly from inside Minecraft.",
  "authors": ["Drakou111"],
  "license": "All Rights Reserved",
  "icon": "neohouse_icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.drakou111.neohouse.NeoHouseFabric"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}"
  }
}
