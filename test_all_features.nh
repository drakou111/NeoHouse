// ============================================================
//  NeoHouse language feature test — covers every construct
// ============================================================

// ── Global variable declarations ─────────────────────────────
long   g.kills    = 0;
double g.ratio    = 1.5d;
string g.lastMsg  = "none";
bool   g.pvpOn    = false;
var    g.anything;

long   t["red"].score   = 0;
string t["blue"].leader = "unknown";

// Player-scoped globals (no initializer allowed)
long   p.streak;
string p.title;

// Variables used in test commands
long   p.a;
long   p.b;
double p.x;
long   p.bits;
long   p.n;
double p.d;
string p.ns;
long   p.count;

// ── Helper functions ──────────────────────────────────────────

// Void function — no return type
function greet(string name) {
    message("Hello, " + name + "!");
}

// Typed function — returns a value
function string makeTitle(string base, long n) {
    return base + " #" + (string)n;
}

// Typed function with if/else on all paths
function long max(long a, long b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

// Recursive-style accumulation (tests function call as expr)
function long clamp(long v, long lo, long hi) {
    if (v < lo) { return lo; }
    if (v > hi) { return hi; }
    return v;
}

// ── Menu definition ───────────────────────────────────────────
menu mainMenu(3) {
    slot0: ({id: "minecraft:diamond", count: 1, tag: {display: {Name: "Close"}}}) {
        closeMenu();
    }
    slot4: ({id: "minecraft:gold_ingot"}) {
        giveItem({id: "minecraft:gold_ingot"}, false, "FIRST_AVAILABLE_SLOT", false);
        message("Here is your gold!");
        closeMenu();
    }
    slot8: ({id: "minecraft:barrier"}) {
        teleport("HOUSE_SPAWN", false);
        closeMenu();
    }
}

// ── Command definitions ───────────────────────────────────────

command stats(priority=5, targeted=true, listed=false) {
    message("Kills: " + (string)g.kills + " | Ratio: " + (string)g.ratio);
}

// Tests assignment operators and bitwise ops
command math {
    p.a = 10;
    p.b = 3;
    p.x = 2.0d;

    p.a += p.b;
    p.a -= 1;
    p.a *= 2;
    p.a /= p.b;
    p.a++;
    p.a--;
    p.x += 0.5d;

    p.bits = 10 & 12;
    p.bits = p.bits | 6;
    p.bits = p.bits ^ 3;
    p.bits = p.bits << 1;
    p.bits = p.bits >> 1;
    p.bits = p.bits >>> 1;

    message("a=" + (string)p.a + " bits=" + (string)p.bits);
}

// Tests every condition
command conditions {
    if (inPortalType(false, "NETHER_PORTAL") || inPortalType(false, "END_PORTAL")) {
        message("In a portal");
    }

    if (isPvpEnabled(false)) {
        message("PvP is on");
    }

    if (isDamageCause(false, "ENTITY_ATTACK")) {
        message("Hit by entity");
    }

    if (isDamageAmount(false, "GREATER_THAN", 5.0d)) {
        message("Big hit");
    }

    if (isBlockType(false, {id: "minecraft:grass_block"}, true)) {
        message("Standing on grass");
    }

    if (isItem(false, {id: "minecraft:diamond_sword"}, "TYPE", "HAND", "ANY")) {
        message("Holding a diamond sword");
    }

    if (isFishingEnvironment(false, "WATER")) {
        message("Fishing in water");
    }

    if (isGroup(false, "default", false)) {
        message("Default rank");
    }

    if (hasPermission(false, "FLY")) {
        message("Can fly");
    }

    if (inRegion(false, "spawn")) {
        message("In spawn region");
    }

    if (hasItem(false, {id: "minecraft:stick"}, "TYPE", "INVENTORY", "ANY")) {
        message("Has a stick somewhere");
    }

    if (doingParkour(false)) {
        message("On a parkour run");
    }

    if (hasPotion(false, "SPEED")) {
        message("Has Speed");
    }

    if (isSneaking(false)) {
        message("Sneaking");
    }

    if (isFlying(false)) {
        message("Flying");
    }

    if (hasHealth(false, "LESS_THAN", 6.0d)) {
        message("Low health!");
    }

    if (hasMaxHealth(false, "EQUAL", 20.0d)) {
        message("Default max health");
    }

    if (hasHunger(false, "GREATER_THAN_OR_EQUAL", 18.0d)) {
        message("Well fed");
    }

    if (hasGamemode(false, "ADVENTURE")) {
        message("Adventure mode");
    }

    if (hasTeam(false, "red")) {
        message("On red team");
    }
}

// Tests expressions, casts, math constants, placeholders, function calls
command expressions {
    p.n = 2 + 3 * 4 - (10 / 2);
    p.d = 3.14d * 2.0d;

    p.ns = (string)p.n;

    message("PI=" + (string)PI + " n=" + p.ns);
    message("name=" + ph.playerName() + " health=" + (string)ph.playerHealth());
    message("title=" + makeTitle("Champion", p.n));
    message("max=" + (string)max(p.n, (long)p.d));

    p.streak = p.n;
    g.kills = g.kills + 1;
    t["red"].score += 1;
}

// Tests repeat and random
command loops {
    p.count = 0;

    repeat(3) {
        p.count++;
    }

    random[
        {
            message("Option A");
        }
        {
            message("Option B");
        }
        {
            message("Option C");
        }
    ]

    random[
        2 * {
            message("Common (weight 2)");
        }
        1 * {
            message("Rare (weight 1)");
        }
    ]

    message("Count after repeat: " + (string)p.count);
}

// Tests all actions
command allActions {
    kill();
    heal();
    clearInventory();
    clearPotion();
    triggerParkourCheckpoint();
    closeMenu();

    message("Hello from allActions!");
    actionBar("This is the action bar");
    title("Big Title", "Subtitle here", 1, 3, 1);
    failParkour("You failed!");

    giveItem({id: "minecraft:apple", count: 1}, false, "FIRST_AVAILABLE_SLOT", false);
    removeItem({id: "minecraft:apple"});
    dropItem({id: "minecraft:stick"}, "CURRENT", true, false, 6000, 10, false, false);

    applyPotion("SPEED", 60, 1, false, true);

    giveXp(1);
    setMaxHealth(20.0d, "SET", true);
    setHealth(20.0d, "SET");
    setHunger(20.0d, "SET");
    setGamemode("ADVENTURE");
    setNameTagDisplay(true);
    setTeam("red");

    enchantItem("PROTECTION", 1);

    setWeather("SUNNY");
    setTime("NOON");

    teleport("HOUSE_SPAWN", false);
    setCompassTarget("HOUSE_SPAWN");
    changeVelocity(0.0d, 1.0d, 0.0d);
    launchToTarget("HOUSE_SPAWN", 2.0d);

    playSound("NOTE_BASS", 1.0d, 1.0d, "CURRENT");

    sendLobby("MAIN_LOBBY");
    applyLayout("default");

    displayMenu("mainMenu");

    setGroup("default", true);

    pause(20);
}

// ── Event handlers ────────────────────────────────────────────

event onJoin {
    greet(ph.playerName());
    p.streak = 0;
    setGamemode("ADVENTURE");
    teleport("HOUSE_SPAWN", false);
}

event onQuit {
    g.kills = 0;
}

event onDeath {
    p.streak = 0;
    message("You died. Streak reset.");
}

event onKill {
    g.kills++;
    p.streak++;
    actionBar(makeTitle("Kill streak", p.streak));
}

event onRespawn {
    heal();
    teleport("HOUSE_SPAWN", false);
}

event onGroupChange {
    message("Your rank changed!");
}

event onPvpStateChange {
    g.pvpOn = !g.pvpOn;
    if (g.pvpOn) {
        message("PvP enabled");
    } else {
        message("PvP disabled");
    }
}

event onFishCaught {
    message("Nice catch!");
    giveXp(1);
}

event onEnterPortal {
    message("Portal entered");
    teleport("HOUSE_SPAWN", false);
}

event onDamage {
    if (hasHealth(false, "LESS_THAN", 4.0d)) {
        heal();
        message("Emergency heal!");
    }
}

event onBlockBreak {
    if (isBlockType(false, {id: "minecraft:diamond_ore"}, true)) {
        message("Rare block!");
        giveXp(5);
    }
}

event onStartParkour {
    message("Parkour started! Good luck.");
}

event onEndParkour {
    message("Parkour complete!");
    giveXp(10);
    p.streak++;
}

event onDropItem {
    Cancel();
    message("Item dropped");
}

event onPickUpItem {
    message("Item picked up");
}

event onChangeHeldItem {
    actionBar("Slot changed");
}

event onToggleSneak {
    if (isSneaking(false)) {
        actionBar("Sneaking...");
    }
}

event onToggleFlight {
    if (isFlying(false)) {
        actionBar("Flying!");
    } else {
        actionBar("Flight off");
    }
}

// ── Loop definitions ──────────────────────────────────────────

loop healthBar(4) {
    actionBar("HP: " + (string)ph.playerHealth() + " / " + (string)ph.playerMaxHealth());
}

loop leaderboard(20) {
    if (g.kills > 0) {
        message("Kills: " + (string)g.kills + " | Best streak: " + (string)p.streak);
    }
}
